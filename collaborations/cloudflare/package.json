{
  "name": "latexdo-collab-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LatexDo's always-on collaboration server on Cloudflare Workers and Durable Objects (free plan).",
  "scripts": {
    "build:web": "npm --prefix ../.. run build:guest",
    "dev": "npm run build:web && wrangler dev --port 8790",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.130.0"
  }
}
