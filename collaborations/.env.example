LATEXDO_COLLAB_HOST=127.0.0.1
LATEXDO_COLLAB_PORT=8787
# Enable only behind a controlled proxy that overwrites X-Forwarded-For.
LATEXDO_COLLAB_TRUST_PROXY=false
LATEXDO_COLLAB_DATA_DIR=/var/lib/latexdo-collaborations

# Public API origin used by clients. Put the reverse-proxy HTTPS origin here.
LATEXDO_COLLAB_PUBLIC_ORIGIN=https://collaborations.example.com

# Optional page that opens share links. Leave empty to share the invite token,
# which desktop users paste into LatexDo.
LATEXDO_COLLAB_SHARE_URL_BASE=

# Comma-separated browser origins allowed to call the API. Use exact origins in
# production. Include http://127.0.0.1:5173 for local Vite testing.
LATEXDO_COLLAB_ALLOWED_ORIGINS=latexdo://app,http://127.0.0.1:5173

# Safety limits. Compilation is not performed on this server.
LATEXDO_COLLAB_MAX_JSON_BYTES=1048576
LATEXDO_COLLAB_MAX_FILE_BYTES=2097152
LATEXDO_COLLAB_MAX_PROJECT_BYTES=20971520
LATEXDO_COLLAB_MAX_PROJECT_FILES=500
LATEXDO_COLLAB_MAX_WS_FRAME_BYTES=524288
LATEXDO_COLLAB_PRESENCE_TTL_MS=45000
